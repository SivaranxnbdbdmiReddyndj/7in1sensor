    BLEDevice::startAdvertising();

    Serial.println("[BLE] Advertising restarted.");
  }
};


// ============================================================
// MODBUS CRC16
// ============================================================

uint16_t modbusCRC(uint8_t *data, uint8_t length)
{
  uint16_t crc = 0xFFFF;

  for (uint8_t i = 0; i < length; i++)
  {
    crc ^= data[i];

    for (uint8_t j = 0; j < 8; j++)
    {
      if (crc & 0x0001)
      {
        crc >>= 1;
        crc ^= 0xA001;
      }
      else
      {
        crc >>= 1;
      }
    }
  }

  return crc;
}


// ============================================================
// READ ONE MODBUS REGISTER
// ============================================================

bool readRegister(uint16_t address, uint16_t &value)
{
  uint8_t request[8];

  request[0] = 0x01;
  request[1] = 0x03;

  request[2] = highByte(address);
  request[3] = lowByte(address);

  request[4] = 0x00;
  request[5] = 0x01;

  uint16_t crc = modbusCRC(request, 6);

  request[6] = lowByte(crc);
  request[7] = highByte(crc);


  // Clear old data

  while (RS485Serial.available())
  {
    RS485Serial.read();
  }


  // ---------------- TRANSMIT ----------------

  digitalWrite(RS485_DE_RE, HIGH);

  delayMicroseconds(200);

  RS485Serial.write(request, 8);

  RS485Serial.flush();

  delayMicroseconds(200);


  // ---------------- RECEIVE ----------------

  digitalWrite(RS485_DE_RE, LOW);


  uint8_t response[32];

  uint8_t length = 0;

  unsigned long startTime = millis();


  while (millis() - startTime < 1000)
  {
    while (RS485Serial.available())
    {
      if (length < sizeof(response))
      {
        response[length++] = RS485Serial.read();
      }
    }
  }


  if (length < 7)
  {
    return false;
  }


  if (response[0] != 0x01)
  {
    return false;
  }


  if (response[1] & 0x80)
  {
    return false;
  }


  if (response[1] != 0x03)
  {
    return false;
  }


  if (response[2] != 0x02)
  {
    return false;
  }


  uint16_t receivedCRC =
    response[length - 2] |
    (response[length - 1] << 8);


  uint16_t calculatedCRC =
    modbusCRC(response, length - 2);


  if (receivedCRC != calculatedCRC)
  {
    Serial.println("[RS485] CRC ERROR");
    return false;
  }


  value =
    ((uint16_t)response[3] << 8) |
    response[4];


  return true;
}


// ============================================================
// READ 7-IN-1 SENSOR
// ============================================================

void read7in1()
{
  uint16_t raw;


  // ---------------- SOIL pH ----------------

  if (readRegister(0x0006, raw))
  {
    soilPH = raw / 100.0;
  }

  delay(100);


  // ---------------- MOISTURE ----------------

  if (readRegister(0x0012, raw))
  {
    soilMoisture = raw / 10.0;
  }

  delay(100);


  // ---------------- SOIL TEMPERATURE ----------------

  if (readRegister(0x0013, raw))
  {
    int16_t signedTemperature = (int16_t)raw;

    soilTemperature =
      signedTemperature / 10.0;
  }

  delay(100);


  // ---------------- EC ----------------

  if (readRegister(0x0015, raw))
  {
    soilEC = raw;
  }

  delay(100);


  // ---------------- NITROGEN ----------------

  if (readRegister(0x001E, raw))
  {
    nitrogen = raw;
  }

  delay(100);


  // ---------------- PHOSPHORUS ----------------

  if (readRegister(0x001F, raw))
  {
    phosphorus = raw;
  }

  delay(100);


  // ---------------- POTASSIUM ----------------

  if (readRegister(0x0020, raw))
  {
    potassium = raw;
  }
}


// ============================================================
// READ SHT40
// ============================================================

void readSHT40()
{
  sensors_event_t humidityEvent;

  sensors_event_t temperatureEvent;


  sht40.getEvent(
    &humidityEvent,
    &temperatureEvent
  );


  airTemperature =
    temperatureEvent.temperature;


  airHumidity =
    humidityEvent.relative_humidity;
}


// ============================================================
// READ TURBIDITY
// ============================================================

void readTurbidity()
{
  long total = 0;


  // Take 20 samples

  for (int i = 0; i < 20; i++)
  {
    total += analogRead(TURBIDITY_PIN);

    delay(10);
  }


  turbidityADC =
    total / 20;


  // ESP32 ADC voltage

  turbidityVoltage =
    (turbidityADC / 4095.0) * 3.3;


  // ----------------------------------------------------------
  // ROUGH LINEAR NTU CALCULATION
  // ----------------------------------------------------------

  turbidityNTU =
    (
      (TURBIDITY_CLEAR_VOLTAGE - turbidityVoltage)
      /
      (TURBIDITY_CLEAR_VOLTAGE -
       TURBIDITY_100NTU_VOLTAGE)
    ) * 100.0;


  // Prevent negative values

  if (turbidityNTU < 0)
  {
    turbidityNTU = 0;
  }


  // Limit maximum displayed value

  if (turbidityNTU > 1000)
  {
    turbidityNTU = 1000;
  }
}


// ============================================================
// READ TDS
// ============================================================

void readTDS()
{
  long total = 0;


  // Take 20 samples

  for (int i = 0; i < 20; i++)
  {
    total += analogRead(TDS_PIN);

    delay(10);
  }


  int raw =
    total / 20;


  tdsADC = raw;


  // ADC voltage

  tdsVoltage =
    (raw / 4095.0) * 3.3;


  // ----------------------------------------------------------
  // WATER TEMPERATURE
  // ----------------------------------------------------------

  // No water-temperature sensor currently available.
  // Therefore using 25°C.

  float waterTemperature = 25.0;


  // ----------------------------------------------------------
  // TEMPERATURE COMPENSATION
  // ----------------------------------------------------------

  float compensationCoefficient =
    1.0 +
    0.02 *
    (waterTemperature - 25.0);


  float compensationVoltage =
    tdsVoltage /
    compensationCoefficient;


  // ----------------------------------------------------------
  // DFRobot TDS FORMULA
  // ----------------------------------------------------------

  float calculatedTDS =
    (
      133.42 *
      pow(compensationVoltage, 3)

      -

      255.86 *
      pow(compensationVoltage, 2)

      +

      857.39 *
      compensationVoltage
    ) * 0.5;


  if (calculatedTDS < 0)
  {
    calculatedTDS = 0;
  }


  // ----------------------------------------------------------
  // YOUR CALIBRATION
  // ----------------------------------------------------------

  tdsValue =
    calculatedTDS *
    TDS_CAL_FACTOR;
}


