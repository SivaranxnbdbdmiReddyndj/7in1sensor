
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <esp_arduino_version.h>
#include <DHT.h>

// ========================================
// BABY MONITORING UNIT - ESP32 TRANSMITTER
// ESP32 Arduino Core 3.3.11 compatible
// ========================================

// SENSOR PINS
#define MIC_AO       34
#define MIC_DO       27

#define DHT_PIN      17
#define DHT_TYPE     DHT11

#define TRIG_PIN     5
#define ECHO_PIN     18

// SETTINGS
#define BABY_DISTANCE_LIMIT 80.0
#define CRY_THRESHOLD       100
#define QUIET_THRESHOLD     70

#define ESPNOW_CHANNEL 1
#define PACKET_MAGIC   0xBABE2026

DHT dht(DHT_PIN, DHT_TYPE);

// ========================================
// ESP-NOW PACKET
// Must exactly match Parent Unit
// ========================================

typedef struct __attribute__((packed)) {

  uint32_t magic;
  uint32_t sequence;

  float distanceCm;
  float temperature;
  float humidity;

  uint16_t soundPeakToPeak;

  uint8_t micDigital;
  uint8_t babyPresent;
  uint8_t presenceValid;
  uint8_t crying;
  uint8_t dhtValid;

} BabyPacket;

BabyPacket packet;

// BROADCAST MAC ADDRESS
uint8_t broadcastAddress[] = {
  0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
};

// ========================================
// GLOBAL VARIABLES
// ========================================

uint32_t sequenceNumber = 0;

bool babyPresent = false;
bool presenceValid = false;
bool crying = false;
bool dhtValid = false;

float currentDistance = -1.0;
float temperature = NAN;
float humidity = NAN;

uint16_t soundPeakToPeak = 0;

int presenceCount = 0;
int absenceCount = 0;

int cryCount = 0;
int silenceCount = 0;

unsigned long lastDHTRead = 0;
unsigned long lastTransmit = 0;

// ========================================
// ULTRASONIC SENSOR
// ========================================

float readDistance() {

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(3);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  unsigned long duration =
    pulseIn(ECHO_PIN, HIGH, 25000);

  if (duration == 0) {
    return -1.0;
  }

  float distance = duration * 0.0343 / 2.0;

  if (distance < 2.0 || distance > 400.0) {
    return -1.0;
  }

  return distance;
}

// ========================================
// BABY PRESENCE DETECTION
// ========================================

void updatePresence() {

  currentDistance = readDistance();

  if (currentDistance < 0) {

    presenceValid = false;

    // Invalid distance is a sensor error.
    // Do not automatically declare baby missing.

    return;
  }

  presenceValid = true;

  if (currentDistance < BABY_DISTANCE_LIMIT) {

    presenceCount++;
    absenceCount = 0;

    if (presenceCount >= 3) {
      babyPresent = true;
    }

  } else {

    absenceCount++;
    presenceCount = 0;

    if (absenceCount >= 3) {
      babyPresent = false;
    }
  }
}

// ========================================
// MICROPHONE ANALOG READING
// ========================================

uint16_t readSoundLevel() {

  int minimumValue = 4095;
  int maximumValue = 0;

  for (int i = 0; i < 100; i++) {

    int value = analogRead(MIC_AO);

    if (value < minimumValue) {
      minimumValue = value;
    }

    if (value > maximumValue) {
      maximumValue = value;
    }

    delayMicroseconds(500);
  }

  return maximumValue - minimumValue;
}

// ========================================
// CRYING DETECTION
// ========================================

void updateCrying() {

  soundPeakToPeak = readSoundLevel();

  if (soundPeakToPeak >= CRY_THRESHOLD) {

    cryCount++;
    silenceCount = 0;

    if (cryCount >= 2) {
      crying = true;
    }

  } else if (soundPeakToPeak < QUIET_THRESHOLD) {

    silenceCount++;
    cryCount = 0;

    if (silenceCount >= 3) {
      crying = false;
    }

  } else {

    cryCount = 0;
    silenceCount = 0;
  }
}

// ========================================
// DHT11 SENSOR
// ========================================

void readDHT() {

  if (millis() - lastDHTRead >= 2000) {

    lastDHTRead = millis();

    float newTemperature = dht.readTemperature();
    float newHumidity = dht.readHumidity();

    if (!isnan(newTemperature) &&
        !isnan(newHumidity)) {

      temperature = newTemperature;
      humidity = newHumidity;

      dhtValid = true;

    } else {

      dhtValid = false;
    }
  }
}

// ========================================
// ESP-NOW SEND CALLBACK
// CORE 2.X AND 3.X COMPATIBLE
// ========================================

#if ESP_ARDUINO_VERSION_MAJOR >= 3

void onDataSent(
  const wifi_tx_info_t *tx_info,
  esp_now_send_status_t status
) {

#else

void onDataSent(
  const uint8_t *mac_addr,
  esp_now_send_status_t status
) {

#endif

  Serial.print("ESP-NOW Send Status: ");

  if (status == ESP_NOW_SEND_SUCCESS) {
    Serial.println("SUCCESS");
  } else {
    Serial.println("FAILED");
  }
}

// ========================================
// TRANSMIT DATA
// ========================================

void transmitData() {

  packet.magic = PACKET_MAGIC;
  packet.sequence = ++sequenceNumber;

  packet.distanceCm = currentDistance;
  packet.temperature = temperature;
  packet.humidity = humidity;

  packet.soundPeakToPeak = soundPeakToPeak;

  packet.micDigital = digitalRead(MIC_DO);

  packet.babyPresent = babyPresent;
  packet.presenceValid = presenceValid;

  packet.crying = crying;
  packet.dhtValid = dhtValid;

  esp_err_t result = esp_now_send(
    broadcastAddress,
    (uint8_t *)&packet,
    sizeof(packet)
  );

  // SERIAL DEBUGGING

  Serial.println("\n========== BABY UNIT ==========");

  Serial.print("Sequence: ");
  Serial.println(sequenceNumber);

  Serial.print("Distance: ");
  Serial.print(currentDistance);
  Serial.println(" cm");

  Serial.print("Presence Valid: ");
  Serial.println(presenceValid ? "YES" : "NO");

  Serial.print("Baby Present: ");
  Serial.println(babyPresent ? "YES" : "NO");

  Serial.print("Sound Peak-to-Peak: ");
  Serial.println(soundPeakToPeak);

  Serial.print("Microphone DO: ");
  Serial.println(digitalRead(MIC_DO));

  Serial.print("Crying: ");
  Serial.println(crying ? "YES" : "NO");

  Serial.print("Temperature: ");
  Serial.println(temperature);

  Serial.print("Humidity: ");
  Serial.println(humidity);

  Serial.print("Send Request: ");

  Serial.println(
    result == ESP_OK ? "ACCEPTED" : "ERROR"
  );

  Serial.println("===============================");
}

// ========================================
// SETUP
// ========================================

void setup() {

  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  pinMode(MIC_DO, INPUT);

  analogReadResolution(12);

  dht.begin();

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  esp_wifi_set_channel(
    ESPNOW_CHANNEL,
    WIFI_SECOND_CHAN_NONE
  );

  Serial.println("\nBABY UNIT STARTING");

  Serial.print("Baby Unit MAC Address: ");
  Serial.println(WiFi.macAddress());

  // INITIALIZE ESP-NOW

  if (esp_now_init() != ESP_OK) {

    Serial.println("ESP-NOW INITIALIZATION FAILED");

    return;
  }

  // REGISTER SEND CALLBACK

  esp_now_register_send_cb(onDataSent);

  // ADD BROADCAST PEER

  esp_now_peer_info_t peerInfo = {};

  memcpy(
    peerInfo.peer_addr,
    broadcastAddress,
    6
  );

  peerInfo.channel = ESPNOW_CHANNEL;
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {

    Serial.println("FAILED TO ADD ESP-NOW PEER");

    return;
  }

  Serial.println("ESP-NOW INITIALIZED");
  Serial.println("CHANNEL: 1");
  Serial.println("BABY UNIT READY");
}

// ========================================
// MAIN LOOP
// ========================================

void loop() {

  updatePresence();

  updateCrying();

  readDHT();

  if (millis() - lastTransmit >= 250) {

    lastTransmit = millis();

    transmitData();
  }
}
