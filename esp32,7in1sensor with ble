// ============================================================
// SEND JSON TO ANDROID APP
// ============================================================

void sendBLEData()
{
  // Bigger document for all fields

  StaticJsonDocument<1024> doc;


  // ==========================================================
  // SOIL
  // ==========================================================

  doc["soil_ph"] =
    soilPH;

  doc["soil_moisture"] =
    soilMoisture;

  doc["soil_temp"] =
    soilTemperature;

  doc["soil_ec"] =
    soilEC;

  doc["nitrogen"] =
    nitrogen;

  doc["phosphorus"] =
    phosphorus;

  doc["potassium"] =
    potassium;


  // ==========================================================
  // AIR
  // ==========================================================

  doc["air_temp"] =
    airTemperature;

  doc["humidity"] =
    airHumidity;


  // ==========================================================
  // WATER pH
  // ==========================================================

  // IMPORTANT:
  // There is currently no separate water-pH probe.
  // This field is provided for Android app compatibility.

  doc["water_ph"] =
    soilPH;


  // ==========================================================
  // TURBIDITY
  // ==========================================================

  doc["turbidity"] =
    turbidityNTU;

  doc["turbidity_ntu"] =
    turbidityNTU;

  doc["turbidity_voltage"] =
    turbidityVoltage;

  doc["turbidity_adc"] =
    turbidityADC;

  doc["turbidity_status"] =
    "Rough calibration";


  // ==========================================================
  // TDS
  // ==========================================================

  doc["tds"] =
    tdsValue;

  doc["tds_adc"] =
    tdsADC;

  doc["tds_voltage"] =
    tdsVoltage;

  doc["tds_temperature_comp"] =
    25.0;


  // ==========================================================
  // DEVICE
  // ==========================================================

  doc["device"] =
    DEVICE_NAME;


  // ==========================================================
  // SERIALIZE JSON
  // ==========================================================

  char jsonBuffer[1024];


  size_t length =
    serializeJson(
      doc,
      jsonBuffer,
      sizeof(jsonBuffer)
    );


  // ==========================================================
  // SEND BLE
  // ==========================================================

  pCharacteristic->setValue(
    (uint8_t*)jsonBuffer,
    length
  );


  pCharacteristic->notify();


  // ==========================================================
  // SERIAL OUTPUT
  // ==========================================================

  Serial.println();

  Serial.println("[BLE] JSON SENT:");

  Serial.println(jsonBuffer);
}


// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);

  delay(2000);


  Serial.println();

  Serial.println("==========================================");

  Serial.println("      AGX AGRILYTHOS SENSOR NODE");

  Serial.println("==========================================");


  // ==========================================================
  // RS485
  // ==========================================================

  pinMode(
    RS485_DE_RE,
    OUTPUT
  );


  digitalWrite(
    RS485_DE_RE,
    LOW
  );


  RS485Serial.begin(
    9600,
    SERIAL_8N1,
    RS485_RX,
    RS485_TX
  );


  Serial.println(
    "[RS485] Started 9600 8N1"
  );


  // ==========================================================
  // I2C
  // ==========================================================

  Wire.begin(
    SHT40_SDA,
    SHT40_SCL
  );


  // ==========================================================
  // SHT40
  // ==========================================================

  if (sht40.begin())
  {
    Serial.println(
      "[SHT40] Sensor detected."
    );


    sht40.setPrecision(
      SHT4X_HIGH_PRECISION
    );


    sht40.setHeater(
      SHT4X_NO_HEATER
    );
  }
  else
  {
    Serial.println(
      "[SHT40] NOT DETECTED!"
    );
  }


  // ==========================================================
  // ADC
  // ==========================================================

  analogReadResolution(12);


  analogSetPinAttenuation(
    TURBIDITY_PIN,
    ADC_11db
  );


  analogSetPinAttenuation(
    TDS_PIN,
    ADC_11db
  );


  // ==========================================================
  // BLE
  // ==========================================================

  Serial.println(
    "[BLE] Starting BLE..."
  );


  BLEDevice::init(
    DEVICE_NAME
  );


  BLEDevice::setMTU(512);


  pServer =
    BLEDevice::createServer();


  pServer->setCallbacks(
    new ServerCallbacks()
  );


  BLEService* pService =
    pServer->createService(
      AGX_SERVICE_UUID
    );


  pCharacteristic =
    pService->createCharacteristic(

      AGX_CHARACTERISTIC_UUID,

      BLECharacteristic::PROPERTY_READ |
      BLECharacteristic::PROPERTY_NOTIFY
    );


  pCharacteristic->addDescriptor(
    new BLE2902()
  );


  pService->start();


  BLEAdvertising* pAdvertising =
    BLEDevice::getAdvertising();


  pAdvertising->addServiceUUID(
    AGX_SERVICE_UUID
  );


  pAdvertising->setScanResponse(
    true
  );


  pAdvertising->setMinPreferred(
    0x06
  );


  BLEDevice::startAdvertising();


  Serial.println();

  Serial.println("==========================================");

  Serial.printf(
    "[BLE] Advertising: %s\n",
    DEVICE_NAME
  );

  Serial.println(
    "[BLE] Waiting for mobile app..."
  );

  Serial.println("==========================================");
}


// ============================================================
// LOOP
// ============================================================

void loop()
{
  if (!deviceConnected)
  {
    delay(100);

    return;
  }


  unsigned long now =
    millis();


  if (
    now - lastReadingTime
    <
    READING_INTERVAL_MS
  )
  {
    delay(10);

    return;
  }


  lastReadingTime =
    now;


  // ==========================================================
  // READ ALL SENSORS
  // ==========================================================

  read7in1();

  readSHT40();

  readTurbidity();

  readTDS();


  // ==========================================================
  // SERIAL
  // ==========================================================

  printSensorData();


  // ==========================================================
  // BLE
  // ==========================================================

  sendBLEData();
}
