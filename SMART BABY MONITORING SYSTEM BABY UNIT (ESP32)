#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <esp_arduino_version.h>
#include <DHT.h>
#include <math.h>

// ================================================
// BABY MONITORING UNIT
// ESP32 + HC-SR04 + MAX4466 + DHT11
// ESP-NOW UNICAST TRANSMITTER
// ================================================

// SENSOR PINS
#define TRIG_PIN       5
#define ECHO_PIN       18
#define SOUND_PIN      34
#define MIC_DIGITAL    27
#define DHT_PIN        17
#define DHT_TYPE       DHT11

// COMMUNICATION
#define ESPNOW_CHANNEL 1
#define PACKET_MAGIC   0xBABE2026

// YOUR PARENT ESP32 MAC ADDRESS
uint8_t parentAddress[] = {
  0xF0, 0x24, 0xF9, 0x5A, 0x27, 0x5C
};

// SENSOR SETTINGS
#define DISTANCE_THRESHOLD 80.0
#define CRY_THRESHOLD      100
#define SILENCE_THRESHOLD  70

DHT dht(DHT_PIN, DHT_TYPE);

// ================================================
// PACKET STRUCTURE
// MUST MATCH PARENT CODE EXACTLY
// ================================================

typedef struct __attribute__((packed)) {
  uint32_t magic;
  uint32_t sequence;

  float distanceCm;
  float temperature;
  float humidity;

  uint16_t soundPeakToPeak;

  uint8_t micDigital;
  uint8_t babyPresent;
  uint8_t presenceValid;
  uint8_t crying;
  uint8_t dhtValid;

} BabyPacket;

static_assert(sizeof(BabyPacket) == 27,
              "Packet must be 27 bytes");

BabyPacket packet;

// ================================================
// GLOBAL VARIABLES
// ================================================

uint32_t sequenceNumber = 0;

float temperature = 0;
float humidity = 0;

bool dhtValid = false;
bool babyPresent = false;
bool presenceValid = false;
bool crying = false;

uint8_t presenceCount = 0;
uint8_t absenceCount = 0;

uint8_t cryCount = 0;
uint8_t quietCount = 0;

uint32_t lastDHTRead = 0;
uint32_t lastSend = 0;
uint32_t lastDebug = 0;

const uint32_t SEND_INTERVAL = 250;

volatile bool callbackReceived = false;
volatile esp_now_send_status_t lastSendStatus =
    ESP_NOW_SEND_FAIL;

// ================================================
// ESP-NOW SEND CALLBACK
// ================================================

#if ESP_ARDUINO_VERSION_MAJOR >= 3

void onDataSent(const wifi_tx_info_t *tx_info,
                esp_now_send_status_t status) {

#else

void onDataSent(const uint8_t *mac_addr,
                esp_now_send_status_t status) {

#endif

  lastSendStatus = status;
  callbackReceived = true;
}

// ================================================
// DISTANCE SENSOR
// ================================================

float readDistance() {

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  unsigned long duration =
      pulseIn(ECHO_PIN, HIGH, 25000);

  if (duration == 0) {
    return -1;
  }

  float distance = duration * 0.0343 / 2.0;

  if (distance < 2 || distance > 400) {
    return -1;
  }

  return distance;
}

// ================================================
// BABY PRESENCE
// ================================================

void updatePresence(float distance) {

  if (distance < 0) {

    presenceValid = false;

    if (absenceCount < 3) {
      absenceCount++;
    }

    presenceCount = 0;

    if (absenceCount >= 3) {
      babyPresent = false;
    }

    return;
  }

  presenceValid = true;

  if (distance < DISTANCE_THRESHOLD) {

    if (presenceCount < 3) {
      presenceCount++;
    }

    absenceCount = 0;

    if (presenceCount >= 3) {
      babyPresent = true;
    }

  } else {

    if (absenceCount < 3) {
      absenceCount++;
    }

    presenceCount = 0;

    if (absenceCount >= 3) {
      babyPresent = false;
    }
  }
}

// ================================================
// MICROPHONE
// ================================================

uint16_t readSoundLevel() {

  int minimumValue = 4095;
  int maximumValue = 0;

  for (int i = 0; i < 100; i++) {

    int value = analogRead(SOUND_PIN);

    if (value < minimumValue) {
      minimumValue = value;
    }

    if (value > maximumValue) {
      maximumValue = value;
    }

    delayMicroseconds(200);
  }

  return maximumValue - minimumValue;
}

// ================================================
// CRY DETECTION
// ================================================

void updateCrying(uint16_t soundLevel) {

  if (soundLevel >= CRY_THRESHOLD) {

    if (cryCount < 2) {
      cryCount++;
    }

    quietCount = 0;

    if (cryCount >= 2) {
      crying = true;
    }

  } else if (soundLevel < SILENCE_THRESHOLD) {

    if (quietCount < 3) {
      quietCount++;
    }

    cryCount = 0;

    if (quietCount >= 3) {
      crying = false;
    }

  } else {

    cryCount = 0;
    quietCount = 0;
  }
}

// ================================================
// DHT11
// ================================================

void readDHT() {

  if (millis() - lastDHTRead >= 2000) {

    lastDHTRead = millis();

    float newTemperature = dht.readTemperature();
    float newHumidity = dht.readHumidity();

    if (!isnan(newTemperature) &&
        !isnan(newHumidity)) {

      temperature = newTemperature;
      humidity = newHumidity;
      dhtValid = true;

    } else {

      dhtValid = false;
      Serial.println("DHT11 READ ERROR");
    }
  }
}

// ================================================
// SEND DATA TO PARENT ESP32
// ================================================

void sendBabyData(float distance,
                  uint16_t soundLevel) {

  packet.magic = PACKET_MAGIC;
  packet.sequence = ++sequenceNumber;

  packet.distanceCm = distance;
  packet.temperature = temperature;
  packet.humidity = humidity;

  packet.soundPeakToPeak = soundLevel;

  packet.micDigital = digitalRead(MIC_DIGITAL);

  packet.babyPresent = babyPresent;
  packet.presenceValid = presenceValid;

  packet.crying = crying;
  packet.dhtValid = dhtValid;

  esp_err_t result = esp_now_send(
      parentAddress,
      (uint8_t *)&packet,
      sizeof(packet)
  );

  Serial.print("ESP-NOW Send: ");

  if (result == ESP_OK) {

    Serial.println("QUEUED");

  } else {

    Serial.print("ERROR: ");
    Serial.println(esp_err_to_name(result));
  }
}

// ================================================
// DEBUG OUTPUT
// ================================================

void printBabyData(float distance,
                   uint16_t soundLevel) {

  Serial.println();
  Serial.println("------ BABY DATA ------");

  Serial.print("Sequence: ");
  Serial.println(sequenceNumber);

  Serial.print("Distance: ");
  Serial.println(distance);

  Serial.print("Baby Present: ");
  Serial.println(babyPresent ? "YES" : "NO");

  Serial.print("Presence Valid: ");
  Serial.println(presenceValid);

  Serial.print("Crying: ");
  Serial.println(crying ? "YES" : "NO");

  Serial.print("Sound Level: ");
  Serial.println(soundLevel);

  Serial.print("Temperature: ");
  Serial.println(temperature);

  Serial.print("Humidity: ");
  Serial.println(humidity);

  Serial.print("DHT Valid: ");
  Serial.println(dhtValid);

  Serial.println("-----------------------");
}

// ================================================
// SETUP
// ================================================

void setup() {

  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("BABY UNIT STARTING");
  Serial.println("================================");

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  pinMode(SOUND_PIN, INPUT);
  pinMode(MIC_DIGITAL, INPUT);

  analogReadResolution(12);

  dht.begin();

  // WIFI STATION MODE
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  delay(200);

  Serial.print("Baby MAC: ");
  Serial.println(WiFi.macAddress());

  esp_wifi_set_ps(WIFI_PS_NONE);

  // SET CHANNEL
  esp_err_t channelResult = esp_wifi_set_channel(
      ESPNOW_CHANNEL,
      WIFI_SECOND_CHAN_NONE
  );

  Serial.print("Channel Setup: ");
  Serial.println(esp_err_to_name(channelResult));

  uint8_t actualChannel;
  wifi_second_chan_t secondaryChannel;

  esp_wifi_get_channel(
      &actualChannel,
      &secondaryChannel
  );

  Serial.print("Actual Channel: ");
  Serial.println(actualChannel);

  // INITIALIZE ESP-NOW
  if (esp_now_init() != ESP_OK) {

    Serial.println("ESP-NOW INIT FAILED");

    while (true) {
      delay(1000);
    }
  }

  Serial.println("ESP-NOW INITIALIZED");

  // REGISTER SEND CALLBACK
  esp_err_t callbackResult =
      esp_now_register_send_cb(onDataSent);

  Serial.print("Callback Registration: ");
  Serial.println(esp_err_to_name(callbackResult));

  // ADD PARENT AS PEER
  esp_now_peer_info_t peerInfo = {};

  memcpy(
      peerInfo.peer_addr,
      parentAddress,
      6
  );

  peerInfo.channel = ESPNOW_CHANNEL;
  peerInfo.encrypt = false;
  peerInfo.ifidx = WIFI_IF_STA;

  esp_err_t peerResult =
      esp_now_add_peer(&peerInfo);

  Serial.print("Parent Peer Addition: ");
  Serial.println(esp_err_to_name(peerResult));

  if (peerResult != ESP_OK) {

    Serial.println("PARENT PEER ADD FAILED");

    while (true) {
      delay(1000);
    }
  }

  Serial.println("PARENT PEER ADDED");
  Serial.println("BABY UNIT READY");
}

// ================================================
// MAIN LOOP
// ================================================

void loop() {

  float distance = readDistance();

  updatePresence(distance);

  uint16_t soundLevel = readSoundLevel();

  updateCrying(soundLevel);

  readDHT();

  // TRANSMIT EVERY 250 MS
  if (millis() - lastSend >= SEND_INTERVAL) {

    lastSend = millis();

    sendBabyData(distance, soundLevel);
  }

  // DELIVERY CALLBACK STATUS
  if (callbackReceived) {

    callbackReceived = false;

    Serial.print("Delivery Status: ");

    if (lastSendStatus == ESP_NOW_SEND_SUCCESS) {
      Serial.println("SUCCESS");
    } else {
      Serial.println("FAIL");
    }
  }

  // SENSOR DEBUG EVERY SECOND
  if (millis() - lastDebug >= 1000) {

    lastDebug = millis();

    printBabyData(distance, soundLevel);
  }
}
